// Smart Collateral Inspection (SCI) — data model
//
// Design notes that matter in a financial-sector system:
//  - Every business entity is scoped to an organization (the institution).
//  - Nothing operational is hard-deleted; deletedAt preserves the record.
//  - Inspection content is snapshotted per submission so a reviewer's decision
//    can always be traced to the exact data they saw.
//  - Photos and PDFs live in object storage; only metadata is stored here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum BranchScope {
  OWN_BRANCH
  ALL_BRANCHES
}

enum InspectionStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
  REPORT_GENERATED
  ARCHIVED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ConditionStatus {
  CRITICAL
  POOR
  FAIR
  GOOD
  EXCELLENT
}

enum OccupancyStatus {
  OWNER_OCCUPIED
  TENANT_OCCUPIED
  VACANT
  PARTIALLY_OCCUPIED
  UNDER_CONSTRUCTION
}

enum OwnershipType {
  FREEHOLD
  LEASEHOLD
  CUSTOMARY
  CO_OWNERSHIP
  COMPANY_OWNED
}

enum PhotoCategory {
  FRONT_VIEW
  REAR_VIEW
  LEFT_SIDE
  RIGHT_SIDE
  INTERIOR
  ROOF
  FOUNDATION
  ROAD_ACCESS
  UTILITIES
  SURROUNDINGS
  DOCUMENT
  OTHER
}

enum LocationSource {
  GPS
  NETWORK
  FUSED
  MANUAL
}

enum CommentType {
  REVIEWER_NOTE
  CORRECTION_REQUEST
  REJECTION_REASON
  APPROVAL_NOTE
  INSPECTOR_RESPONSE
}

enum NotificationType {
  ASSIGNMENT_CREATED
  ASSIGNMENT_CHANGED
  INSPECTION_SUBMITTED
  INSPECTION_APPROVED
  INSPECTION_REJECTED
  CORRECTION_REQUESTED
  REPORT_READY
  SYSTEM_ALERT
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  CURRENCY
  DATE
  SELECT
  MULTI_SELECT
  BOOLEAN
  PHONE
  EMAIL
  NATIONAL_ID
}

model Organization {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  legalName      String?
  taxId          String?
  addressLine    String?
  phone          String?
  email          String?
  logoStorageKey String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  branches    Branch[]
  users       User[]
  roles       Role[]
  properties  Property[]
  inspections Inspection[]
  templates   InspectionTemplate[]
  reports     Report[]
  auditLogs   AuditLog[]
  divisions   AdministrativeDivision[]

  @@map("organizations")
}

model AdministrativeDivision {
  id             String   @id @default(uuid())
  organizationId String
  parentId       String?
  level          Int
  name           String
  code           String?
  createdAt      DateTime @default(now())

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       AdministrativeDivision?  @relation("DivisionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     AdministrativeDivision[] @relation("DivisionTree")

  properties Property[]
  branches   Branch[]

  @@index([organizationId, level])
  @@index([parentId])
  @@map("administrative_divisions")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  name           String
  addressLine    String?
  divisionId     String?
  phone          String?
  email          String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  division     AdministrativeDivision? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  users       User[]
  properties  Property[]
  inspections Inspection[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model Permission {
  id          String @id @default(uuid())
  code        String @unique
  category    String
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String
  code           String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, code])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                  String      @id @default(uuid())
  organizationId      String
  branchId            String?
  email               String      @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  employeeNumber      String?
  status              UserStatus  @default(PENDING_ACTIVATION)
  branchScope         BranchScope @default(OWN_BRANCH)
  failedLoginAttempts Int         @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  mustChangePassword  Boolean     @default(false)
  passwordChangedAt   DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  userRoles      UserRole[]
  sessions       Session[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  deviceTokens   DeviceToken[]
  auditLogs      AuditLog[]
  notifications  Notification[]

  inspectionsAssigned  Inspection[]            @relation("InspectionInspector")
  inspectionsReviewing Inspection[]            @relation("InspectionReviewer")
  inspectionsCreated   Inspection[]            @relation("InspectionCreator")
  comments             InspectionComment[]
  statusEvents         InspectionStatusEvent[]
  photosCaptured       InspectionPhoto[]
  reportsGenerated     Report[]
  correctionsRaised    CorrectionRequest[]
  feesRequested        InspectionFee[]         @relation("FeeRequestedBy")

  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@map("users")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  userAgent  String?
  ipAddress  String?
  deviceId   String?
  platform   String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id            String    @id @default(uuid())
  userId        String
  sessionId     String
  tokenHash     String    @unique
  familyId      String
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model DeviceToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  platform   String
  deviceId   String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model InspectionTemplate {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  name           String
  description    String?
  version        Int          @default(1)
  isDefault      Boolean      @default(false)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections     TemplateSection[]
  photoRules   TemplatePhotoRule[]
  inspections  Inspection[]

  @@unique([organizationId, code, version])
  @@index([organizationId])
  @@map("inspection_templates")
}

model TemplateSection {
  id           String  @id @default(uuid())
  templateId   String
  code         String
  name         String
  isAssessment Boolean @default(false)
  sortOrder    Int     @default(0)

  template InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fields   TemplateField[]

  @@unique([templateId, code])
  @@map("template_sections")
}

model TemplateField {
  id         String    @id @default(uuid())
  sectionId  String
  code       String
  label      String
  type       FieldType
  required   Boolean   @default(false)
  sortOrder  Int       @default(0)
  options    Json?
  validation Json?
  helpText   String?

  section TemplateSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  values  InspectionValue[]

  @@unique([sectionId, code])
  @@map("template_fields")
}

model TemplatePhotoRule {
  id          String        @id @default(uuid())
  templateId  String
  category    PhotoCategory
  minCount    Int           @default(1)
  required    Boolean       @default(true)
  description String?

  template InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, category])
  @@map("template_photo_rules")
}

// Basic property registration. Detailed collateral information belongs to the
// inspection and is intentionally not required when creating a property.
model Property {
  id             String    @id @default(uuid())
  organizationId String
  branchId       String
  reference      String
  name           String?
  propertyType   String
  ownerClientName String?
  province       String?
  district       String?
  sector         String?
  cell           String?
  villageStreet  String?

  // Legacy fields retained so existing records remain readable. New property
  // creation no longer collects these values.
  addressLine    String?
  divisionId     String?
  plotNumber     String?
  titleNumber    String?
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  division     AdministrativeDivision? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  inspections  Inspection[]

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([branchId])
  @@index([ownerClientName])
  @@map("properties")
}

model Inspection {
  id               String           @id @default(uuid())
  organizationId   String
  branchId         String
  propertyId       String
  templateId       String
  inspectionNumber String
  loanReference    String
  clientName       String?
  status           InspectionStatus @default(ASSIGNED)
  priority         Priority         @default(NORMAL)

  inspectorId String?
  reviewerId  String?
  createdById String

  assignedAt  DateTime  @default(now())
  dueDate     DateTime?
  startedAt   DateTime?
  submittedAt DateTime?
  reviewedAt  DateTime?
  approvedAt  DateTime?

  assignmentNotes String?
  submissionCount Int @default(0)
  version Int @default(1)
  clientRequestId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  template     InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  inspector    User?              @relation("InspectionInspector", fields: [inspectorId], references: [id], onDelete: SetNull)
  reviewer     User?              @relation("InspectionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdBy    User               @relation("InspectionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  owner        InspectionOwner?
  valuation    InspectionValuation?
  fee          InspectionFee?
  locations    InspectionLocation[]
  values       InspectionValue[]
  assessments  InspectionAssessment[]
  photos       InspectionPhoto[]
  comments     InspectionComment[]
  statusEvents InspectionStatusEvent[]
  corrections  CorrectionRequest[]
  reports      Report[]
  snapshots    InspectionSnapshot[]

  @@unique([organizationId, inspectionNumber])
  @@unique([clientRequestId])
  @@index([organizationId, status])
  @@index([branchId, status])
  @@index([inspectorId, status])
  @@index([reviewerId, status])
  @@index([submittedAt])
  @@index([loanReference])
  @@map("inspections")
}

model InspectionOwner {
  id              String           @id @default(uuid())
  inspectionId    String           @unique
  fullName        String
  nationalIdEnc   String?
  nationalIdHash  String?
  phone           String?
  email           String?
  occupancyStatus OccupancyStatus?
  ownershipType   OwnershipType?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([nationalIdHash])
  @@map("inspection_owners")
}

model InspectionValue {
  id           String    @id @default(uuid())
  inspectionId String
  fieldId      String
  valueText    String?
  valueNumber  Decimal?  @db.Decimal(18, 2)
  valueDate    DateTime?
  valueBool    Boolean?
  valueJson    Json?

  inspection Inspection    @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  field      TemplateField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, fieldId])
  @@index([inspectionId])
  @@map("inspection_values")
}

model InspectionAssessment {
  id           String           @id @default(uuid())
  inspectionId String
  categoryCode String
  categoryName String
  rating       Int?
  condition    ConditionStatus?
  notes        String?
  sortOrder    Int              @default(0)
  updatedAt    DateTime         @updatedAt

  inspection Inspection        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  photos     InspectionPhoto[]

  @@unique([inspectionId, categoryCode])
  @@index([inspectionId])
  @@map("inspection_assessments")
}

model InspectionValuation {
  id              String   @id @default(uuid())
  inspectionId    String   @unique
  currency        String   @default("RWF")
  marketValue     Decimal? @db.Decimal(18, 2)
  forcedSaleValue Decimal? @db.Decimal(18, 2)
  replacementCost Decimal? @db.Decimal(18, 2)
  rentalEstimate  Decimal? @db.Decimal(18, 2)
  comments        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("inspection_valuations")
}

model InspectionLocation {
  id                    String         @id @default(uuid())
  inspectionId          String
  latitude              Decimal        @db.Decimal(10, 7)
  longitude             Decimal        @db.Decimal(10, 7)
  accuracyM             Float?
  altitudeM             Float?
  source                LocationSource @default(GPS)
  isMocked              Boolean        @default(false)
  capturedAt            DateTime
  distanceFromPropertyM Int?
  createdAt             DateTime       @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("inspection_locations")
}

model InspectionPhoto {
  id             String        @id @default(uuid())
  inspectionId   String
  assessmentId   String?
  category       PhotoCategory
  storageKey     String
  thumbnailKey   String?
  mimeType       String
  sizeBytes      Int
  width          Int?
  height         Int?
  checksumSha256 String
  caption        String?
  latitude       Decimal?      @db.Decimal(10, 7)
  longitude      Decimal?      @db.Decimal(10, 7)
  accuracyM      Float?
  capturedAt     DateTime?
  capturedById   String
  clientRequestId String?
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?

  inspection Inspection            @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  assessment InspectionAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  capturedBy User                  @relation(fields: [capturedById], references: [id], onDelete: Restrict)

  @@unique([clientRequestId])
  @@index([inspectionId, category])
  @@map("inspection_photos")
}

model InspectionComment {
  id           String      @id @default(uuid())
  inspectionId String
  authorId     String
  type         CommentType @default(REVIEWER_NOTE)
  body         String
  createdAt    DateTime    @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("inspection_comments")
}

model InspectionStatusEvent {
  id              String            @id @default(uuid())
  inspectionId    String
  fromStatus      InspectionStatus?
  toStatus        InspectionStatus
  actorId         String?
  comment         String?
  submissionRound Int?
  createdAt       DateTime          @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  actor      User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inspectionId, createdAt])
  @@map("inspection_status_events")
}

model CorrectionRequest {
  id              String    @id @default(uuid())
  inspectionId    String
  requestedById   String
  reason          String
  targetSections  Json?
  submissionRound Int
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  inspection  Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  requestedBy User       @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([inspectionId])
  @@map("correction_requests")
}

model InspectionSnapshot {
  id              String   @id @default(uuid())
  inspectionId    String
  submissionRound Int
  payload         Json
  createdAt       DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, submissionRound])
  @@map("inspection_snapshots")
}

model Report {
  id             String   @id @default(uuid())
  organizationId String
  inspectionId   String
  reportNumber   String
  version        Int      @default(1)
  storageKey     String
  checksumSha256 String
  sizeBytes      Int
  generatedById  String
  generatedAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspection   Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  generatedBy  User         @relation(fields: [generatedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, reportNumber, version])
  @@index([inspectionId])
  @@map("reports")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  previousValue  Json?
  newValue       Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

enum FeeStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

model InspectionFee {
  id           String     @id @default(uuid())
  inspectionId String     @unique
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  amount   Int    @default(15000)
  currency String @default("RWF")
  phoneNumber String
  status FeeStatus @default(PENDING)
  providerRef String? @unique
  failureReason String?
  requestedById String
  requestedBy   User   @relation("FeeRequestedBy", fields: [requestedById], references: [id])
  requestedAt DateTime  @default(now())
  settledAt   DateTime?

  @@index([status])
  @@map("inspection_fees")
}
